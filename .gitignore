# Rust build output
/target/
**/*.rs.bk
*.profraw

# Bundled online controller bytecode
__pycache__/
*.py[cod]

# Fuzzing artifacts
/fuzz/artifacts/
/fuzz/corpus/
/fuzz/target/

# Corpus harness: git cache and run outputs never live in the repo
# (default cache is $JSSPECTOR_CORPUS_DIR, outside the project)
/corpus/.cache/
/corpus/runs/

# HEAD findings on real apps may be undisclosed vulnerabilities: they belong in the
# private companion repo, never here (see SECURITY.md)
/corpus/findings/
*.findings.json
/.satori/reports/
/.satori/exploitability-regressions.json
# The fix recipe store's lock and temporary files
/.satori/fix-recipes/**/.*
# Exact learned examples now live under the user's private data directory, never in this public
# checkout. Ignore the legacy on-tree store so a future research run cannot stage a disclosure.
/.satori/fix-recipes/examples/
/.satori/fix-recipes/recipes/

# Online research artifacts can contain undisclosed repositories, PoCs and callback tokens.
/runs/

# Local presentation exports are not project sources.
/JSSpector-narration.*

# OS / editor
.DS_Store
.idea/
.vscode/
